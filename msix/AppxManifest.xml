<?xml version="1.0" encoding="utf-8"?>
<!--
  IMPORTANT: Lines marked [FILL IN FROM PARTNER CENTER] must be replaced
  with the exact values shown by Partner Center AFTER reserving the app name
  (Dashboard → Your app → Product management → App identity).
  Publisher and Name are shown there character-for-character — simply
  copy them from Partner Center; do not make them up yourself. If even
  one character does not match, the package upload to Partner Center will be rejected.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="[FILL IN FROM PARTNER CENTER: Package/Identity/Name]"
    Publisher="[FILL IN FROM PARTNER CENTER: Package/Identity/Publisher, e.g. CN=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX]"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>WAT Pro (Web Automation Tools)</DisplayName>
    <PublisherDisplayName>[FILL IN FROM PARTNER CENTER: account publisher name]</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ru-ru" />
  </Resources>

  <Applications>
    <Application Id="WATPro" Executable="WAT Pro.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="WAT Pro (Web Automation Tools)"
        Description="A web page automation and testing tool: scripts, JS console, form auto-fill, task scheduler, and e-mail notifications."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" Square310x310Logo="Images\Square310x310Logo.png" Square71x71Logo="Images\Square71x71Logo.png" />
        <uap:SplashScreen Image="Images\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- runFullTrust is required for any classic Win32 application
         packaged through Desktop Bridge (not UWP) -->
    <rescap:Capability Name="runFullTrust" />
    <!-- The application accesses the network (browser, SMTP) -->
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
