<?xml version="1.0" encoding="utf-8"?>
<!--
  ВАЖНО: строки с пометкой [ЗАПОЛНИТЬ ИЗ PARTNER CENTER] нужно заменить
  на точные значения, которые Partner Center покажет ПОСЛЕ резервирования
  имени приложения (Dashboard → Ваше приложение → Product management →
  App identity). Publisher и Name там показаны буква-в-букву — просто
  скопируйте оттуда, не придумывайте сами: если не совпадёт хоть один
  символ, загрузка пакета в Partner Center будет отклонена.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="[ЗАПОЛНИТЬ ИЗ PARTNER CENTER: Package/Identity/Name]"
    Publisher="[ЗАПОЛНИТЬ ИЗ PARTNER CENTER: Package/Identity/Publisher, напр. CN=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX]"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>WAT Pro (Web Automation Tools)</DisplayName>
    <PublisherDisplayName>[ЗАПОЛНИТЬ ИЗ PARTNER CENTER: имя издателя аккаунта]</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ru-ru" />
  </Resources>

  <Applications>
    <Application Id="WATPro" Executable="WAT Pro.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="WAT Pro (Web Automation Tools)"
        Description="Инструмент автоматизации и тестирования веб-страниц: сценарии, JS-консоль, авто-заполнение форм, планировщик задач, e-mail уведомления."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" Square310x310Logo="Images\Square310x310Logo.png" Square71x71Logo="Images\Square71x71Logo.png" />
        <uap:SplashScreen Image="Images\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- runFullTrust обязателен для любого классического Win32-приложения,
         упакованного через Desktop Bridge (не UWP) -->
    <rescap:Capability Name="runFullTrust" />
    <!-- приложение ходит в сеть (браузер, SMTP) -->
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
